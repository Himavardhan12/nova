<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/student-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <h3 class="fw-bold mb-0"><%= student.name %></h3>
        <p class="text-muted mb-0">
          <span class="badge text-bg-dark font-monospace"><%= student.student_code %></span>
          <span class="badge text-bg-primary"><%= student.class %> - <%= student.section %></span>
        </p>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
          <div class="card stat-card h-100">
            <div class="card-body">
              <div class="stat-label">Total Fees Due</div>
              <div class="stat-value">₹<%= Number(fee.totalDue).toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card stat-card h-100">
            <div class="card-body">
              <div class="stat-label">Paid</div>
              <div class="stat-value text-success">₹<%= Number(fee.totalPaid).toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card stat-card h-100">
            <div class="card-body">
              <div class="stat-label">Remaining</div>
              <div class="stat-value <%= fee.remaining > 0 ? 'text-danger' : 'text-success' %>">₹<%= Number(fee.remaining).toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card stat-card h-100">
            <div class="card-body">
              <div class="stat-label">Activities Enrolled</div>
              <div class="stat-value"><%= enrolledCount %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header">Fee Progress</div>
        <div class="card-body">
          <% const pct = fee.totalDue ? Math.min(100, (fee.totalPaid / fee.totalDue) * 100) : 100; %>
          <div class="d-flex justify-content-between mb-2">
            <span class="small text-muted">₹<%= Number(fee.totalPaid).toLocaleString('en-IN') %> paid</span>
            <span class="small fw-semibold">₹<%= Number(fee.totalDue).toLocaleString('en-IN') %> total</span>
          </div>
          <div class="progress" style="height: 14px;">
            <div class="progress-bar <%= fee.remaining > 0 ? 'bg-warning' : 'bg-success' %>" style="width: <%= pct %>%"></div>
          </div>
          <% if (fee.remaining > 0) { %>
            <p class="small text-danger mt-2 mb-0">₹<%= Number(fee.remaining).toLocaleString('en-IN') %> is still pending. Please contact the school office.</p>
          <% } else { %>
            <p class="small text-success mt-2 mb-0">All fees are paid.</p>
          <% } %>
          <a href="/student/fees" class="btn btn-sm btn-outline-primary mt-3">View Fee Details</a>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="fw-bold">Academics</h5>
              <p class="small text-muted"><%= marksCount %> mark entries recorded across exams.</p>
              <a href="/student/academics" class="btn btn-sm btn-outline-info">View Performance</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="fw-bold">Transport</h5>
              <p class="small text-muted"><%= student.transport_route_id ? student.route_name : 'Not enrolled in transport.' %></p>
              <a href="/student/transport" class="btn btn-sm btn-outline-success">View Details</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="fw-bold">Complaints</h5>
              <p class="small text-muted"><%= openComplaints %> open complaint(s).</p>
              <a href="/student/complaints" class="btn btn-sm btn-outline-warning">My Complaints</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
