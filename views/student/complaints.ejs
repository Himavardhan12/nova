<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/student-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <h3 class="fw-bold mb-0">My Complaints</h3>
        <p class="text-muted mb-0">Submit and track your complaints</p>
      </div>

      <% if (success) { %><div class="alert alert-success">Your complaint has been submitted.</div><% } %>

      <div class="row g-4">
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">Submit New Complaint</div>
            <div class="card-body">
              <form method="POST" action="/student/complaints/new">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Title *</label>
                  <input type="text" name="title" class="form-control" placeholder="Brief title" required>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Category</label>
                  <select name="category" class="form-select">
                    <option value="other">Other</option>
                    <option value="infrastructure">Infrastructure</option>
                    <option value="academic">Academic</option>
                    <option value="transport">Transport</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Description</label>
                  <textarea name="description" class="form-control" rows="4" placeholder="Describe your complaint..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Submit Complaint</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">My Complaints (<%= complaints.length %>)</div>
            <div class="card-body">
              <% if (complaints.length) { %>
                <% complaints.forEach(c => { %>
                  <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                      <div>
                        <h6 class="fw-bold mb-1"><%= c.title %></h6>
                        <div class="small text-muted">
                          <span class="text-capitalize"><%= c.category %></span>
                          <span class="mx-2">|</span>
                          <%= c.created_at.slice(0,16) %>
                        </div>
                      </div>
                      <span class="badge badge-<%= c.status %>"><%= c.status.replace('_',' ') %></span>
                    </div>
                    <% if (c.description) { %><p class="small mt-2 mb-2"><%= c.description %></p><% } %>
                    <% if (c.admin_remark) { %>
                      <div class="alert alert-light py-2 small mb-0"><strong>School Response:</strong> <%= c.admin_remark %></div>
                    <% } %>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-center text-muted py-5 mb-0">You have not submitted any complaints yet.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
