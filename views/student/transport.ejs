<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/student-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <h3 class="fw-bold mb-0">Transport Details</h3>
        <p class="text-muted mb-0">School bus route and fee information</p>
      </div>

      <% if (student.transport_route_id) { %>
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="card mb-4">
              <div class="card-header">Route Information</div>
              <div class="card-body">
                <dl class="detail-grid row mb-0">
                  <dt class="col-sm-4">Route Name</dt><dd class="col-sm-8"><%= student.route_name %></dd>
                  <dt class="col-sm-4">Stops</dt><dd class="col-sm-8"><%= student.stops || 'N/A' %></dd>
                  <dt class="col-sm-4">Your Pickup Point</dt><dd class="col-sm-8 fw-bold"><%= student.pickup_point || 'N/A' %></dd>
                  <dt class="col-sm-4">Monthly Fee</dt><dd class="col-sm-8">₹<%= student.monthly_fee %></dd>
                  <dt class="col-sm-4">Annual Fee (10 months)</dt><dd class="col-sm-8">₹<%= fee.transportDue.toLocaleString('en-IN') %></dd>
                </dl>
              </div>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="card mb-4">
              <div class="card-header">Transport Fee Status</div>
              <div class="card-body text-center">
                <div class="small text-muted">Paid</div>
                <div class="stat-value text-success">₹<%= fee.transportPaid.toLocaleString('en-IN') %></div>
                <div class="small text-muted mt-2">Remaining</div>
                <div class="fw-bold fs-4 <%= fee.transportRemaining > 0 ? 'text-danger' : 'text-success' %>">₹<%= fee.transportRemaining.toLocaleString('en-IN') %></div>
                <div class="progress progress-thin mt-3">
                  <% const tpct = fee.transportDue ? Math.min(100, (fee.transportPaid / fee.transportDue) * 100) : 100; %>
                  <div class="progress-bar <%= fee.transportRemaining > 0 ? 'bg-warning' : 'bg-success' %>" style="width: <%= tpct %>%"></div>
                </div>
              </div>
            </div>
            <div class="card">
              <div class="card-body">
                <h6 class="fw-bold">Bus Timings</h6>
                <p class="small text-muted mb-1">Morning Pickup: 7:15 AM - 8:00 AM (route dependent)</p>
                <p class="small text-muted mb-0">Evening Drop: 3:45 PM - 4:30 PM (route dependent)</p>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="card">
          <div class="card-body text-center text-muted py-5">
            
            <p class="mt-2 mb-0">You are not enrolled in school transport.</p>
            <p class="small mb-0">Contact the school office for transport enrollment.</p>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
