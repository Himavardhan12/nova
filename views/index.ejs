<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <h1 class="mb-3">Student records, fees and exam results for Nursery through Class 10</h1>
        <p class="lead mb-4">
          This portal is used by Sunrise Public School staff, students and parents to manage
          and view admission details, fee payments, marks, bus routes and complaints.
        </p>
        <a href="/login" class="btn btn-warning btn-lg px-4 fw-semibold">Sign in to the portal</a>
      </div>
    </div>
  </div>
</section>

<section class="container my-5" id="classes">
  <div class="mb-4">
    <h2 class="fw-bold">Classes covered</h2>
    <p class="text-muted">One student record system from entry level through the secondary board year.</p>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered bg-white">
      <thead class="table-light">
        <tr>
          <th>Stage</th>
          <th>Classes</th>
          <th>Subjects offered</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="fw-semibold">Early years</td>
          <td>Nursery, LKG, UKG</td>
          <td>English, Kannada, Mathematics, EVS, Drawing</td>
        </tr>
        <tr>
          <td class="fw-semibold">Primary</td>
          <td>Class 1 to Class 5</td>
          <td>English, Kannada, Mathematics, EVS, Drawing</td>
        </tr>
        <tr>
          <td class="fw-semibold">Middle school</td>
          <td>Class 6 to Class 8</td>
          <td>English, Kannada, Hindi, Mathematics, Science, Social Science, Computer</td>
        </tr>
        <tr>
          <td class="fw-semibold">Secondary (SSLC)</td>
          <td>Class 9 and Class 10</td>
          <td>English, Kannada, Hindi, Mathematics, Science, Social Science, Computer, Physical Education</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="container mb-5">
  <h2 class="fw-bold mb-4">What the portal provides</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Student profiles</h5>
          <p class="text-muted small mb-0">
            Every admitted student is issued a unique ID (format STU-YYYY-NNN). The profile
            holds personal details, address, parent name and phone, guardian name and phone,
            blood group and admission date.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Fee tracking</h5>
          <p class="text-muted small mb-0">
            Tuition, transport and activity fees are tracked separately. Each student record
            shows the total assessed, amount paid, receipts issued and the balance remaining.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Academics, transport and complaints</h5>
          <p class="text-muted small mb-0">
            Exam marks and grades are recorded per subject. Bus route and pickup point details
            are shown for enrolled students. Complaints can be submitted and tracked to resolution.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
