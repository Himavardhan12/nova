<%- include('partials/header') %>

<section class="hero">
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="badge text-bg-warning mb-3 px-3 py-2">Admissions Open 2026-27</span>
        <h1 class="display-4 mb-3">Nurturing Excellence from Nursery to SSLC</h1>
        <p class="lead mb-4 opacity-90">
          Sunrise Public School is committed to academic excellence, character building and holistic development
          of every child. Track academics, fees, transport and more through our digital portal.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="/login" class="btn btn-warning btn-lg px-4 fw-semibold">
            <i class="bi bi-box-arrow-in-right me-2"></i>Login to Portal
          </a>
          <a href="#classes" class="btn btn-outline-light btn-lg px-4">
            <i class="bi bi-book me-2"></i>Our Classes
          </a>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <div class="p-5">
          <i class="bi bi-mortarboard" style="font-size: 11rem; color: rgba(255,255,255,.15);"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container my-5" id="classes">
  <div class="text-center mb-4">
    <h2 class="fw-bold">Classes Offered</h2>
    <p class="text-muted">Complete education journey — foundational years to secondary board preparation</p>
  </div>
  <div class="row g-3">
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <i class="bi bi-heart-fill text-danger fs-1"></i>
          <h5 class="mt-2 mb-0">Early Years</h5>
          <p class="small text-muted mb-0">Nursery, LKG, UKG</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <i class="bi bi-blockquote-left text-primary fs-1"></i>
          <h5 class="mt-2 mb-0">Primary</h5>
          <p class="small text-muted mb-0">Class 1 to Class 5</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <i class="bi bi-graph-up text-success fs-1"></i>
          <h5 class="mt-2 mb-0">Middle School</h5>
          <p class="small text-muted mb-0">Class 6 to Class 8</p>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <i class="bi bi-mortarboard text-warning fs-1"></i>
          <h5 class="mt-2 mb-0">Secondary</h5>
          <p class="small text-muted mb-0">Class 9 &amp; Class 10 (SSLC)</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container mb-5">
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <i class="bi bi-person-video3 text-primary fs-1"></i>
          <h5 class="mt-3">Student Profiles</h5>
          <p class="text-muted small mb-0">Every student gets a unique ID and a complete profile with personal details, parent &amp; guardian contacts.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <i class="bi bi-wallet2 text-success fs-1"></i>
          <h5 class="mt-3">Transparent Fees</h5>
          <p class="text-muted small mb-0">Live view of paid, pending and remaining fees across tuition, transport and extra activities.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <i class="bi bi-bus-front text-warning fs-1"></i>
          <h5 class="mt-3">Transport &amp; Activities</h5>
          <p class="text-muted small mb-0">Bus route tracking, sports, dance, music enrollments — everything in one place.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
