    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="about-panel">
          <h3>School overview</h3>
          <div class="stage-meta">
            <div class="stage-meta-item">
              <span class="stage-label">Established</span>
              <span class="stage-value">1985</span>
            </div>
            <div class="stage-meta-item">
              <span class="stage-label">Affiliation</span>
              <span class="stage-value">Karnataka State Board (Nursery to Class 10 SSLC)</span>
            </div>
            <div class="stage-meta-item">
              <span class="stage-label">Campus</span>
              <span class="stage-value">4.5 acres, Bengaluru</span>
