<script>
function showTab(group, id, btn) {
  document.querySelectorAll('[data-group="' + group + '"]').forEach(function (el) { el.hidden = true; });
  document.querySelectorAll('[data-tabbtn="' + group + '"]').forEach(function (el) { el.classList.remove('active'); });
  document.getElementById(id).hidden = false;
  btn.classList.add('active');
  var panelId = group === 'stage-group' ? 'stage-panel' : 'fees-panel';
  var panel = document.getElementById(panelId);
  panel.hidden = false;
  panel.style.animation = 'none';
  panel.offsetHeight;
  panel.style.animation = '';
}

(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var targets = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('in'); });
    var chart = document.querySelector('.bar-chart');
    if (chart) { chart.classList.add('grown'); document.querySelectorAll('.bar-val').forEach(function (el) { el.textContent = el.dataset.target; }); }
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      var el = e.target;
      var d = el.dataset.delay ? parseInt(el.dataset.delay, 10) : 0;
      setTimeout(function () { el.classList.add('in'); }, d);
      io.unobserve(el);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  targets.forEach(function (el) { io.observe(el); });

  var chart = document.querySelector('.bar-chart');
  if (chart) {
    var cio = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        chart.classList.add('grown');
        chart.querySelectorAll('.bar-col').forEach(function (col, i) {
          var bar = col.querySelector('.bar');
          var val = col.querySelector('.bar-val');
          if (bar) { bar.style.transitionDelay = (i * 90) + 'ms'; }
          if (val) {
            var target = parseInt(val.dataset.target.replace(/,/g, ''), 10);
            var suffix = val.dataset.suffix || '';
            var start = performance.now();
            var dur = 1100;
            var delay = 300 + i * 90;
            setTimeout(function () {
              function tick(now) {
                var p = Math.min((now - start) / dur, 1);
                var eased = 1 - Math.pow(1 - p, 3);
                val.textContent = Math.round(target * eased).toLocaleString('en-IN') + suffix;
                if (p < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(function (t) { start = t; requestAnimationFrame(tick); });
            }, delay);
          }
        });
        cio.unobserve(chart);
      });
    }, { threshold: 0.3 });
    cio.observe(chart);
  }
})();
</script>

