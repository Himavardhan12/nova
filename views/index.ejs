<script>
function showTab(group, id, btn) {
  document.querySelectorAll('[data-group="' + group + '"]').forEach(function (el) { el.hidden = true; });
  document.querySelectorAll('[data-tabbtn="' + group + '"]').forEach(function (el) { el.classList.remove('active'); });
  document.getElementById(id).hidden = false;
  btn.classList.add('active');
  var panelId = group === 'stage-group' ? 'stage-panel' : 'fees-panel';
  document.getElementById(panelId).hidden = false;
}
</script>

