<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <h1 class="mb-3">Student records, fees and exam results for Nursery through Class 10</h1>
        <p class="lead mb-4">
          This portal is used by Sunrise Public School staff, students and parents to manage
          and view admission details, fee payments, marks, bus routes and complaints.
        </p>
        <a href="/login" class="btn btn-warning btn-lg px-4 fw-semibold">Sign in to the portal</a>
      </div>
    </div>
  </div>
</section>

<section class="stage-section" id="classes">
  <div class="container py-5">
    <div class="mb-4">
      <h2 class="fw-bold text-white">Classes covered</h2>
      <p class="stage-sub">One student record system from entry level through the secondary board year.</p>
    </div>

    <div class="stage-tabs" role="tablist">
      <button class="stage-btn" data-tabbtn="stage-group" onclick="showTab('stage-group','stage-early', this)">Early Years</button>
      <button class="stage-btn" data-tabbtn="stage-group" onclick="showTab('stage-group','stage-primary', this)">Primary</button>
      <button class="stage-btn" data-tabbtn="stage-group" onclick="showTab('stage-group','stage-middle', this)">Middle School</button>
      <button class="stage-btn" data-tabbtn="stage-group" onclick="showTab('stage-group','stage-secondary', this)">Secondary (SSLC)</button>
    </div>

    <div class="stage-panel" id="stage-panel" hidden>
      <div class="stage-detail" data-group="stage-group" id="stage-early" hidden>
        <h3>Early Years</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Nursery, LKG, UKG</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Mathematics, EVS, Drawing</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" data-group="stage-group" id="stage-primary" hidden>
        <h3>Primary</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 1 to Class 5</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Mathematics, EVS, Drawing</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" data-group="stage-group" id="stage-middle" hidden>
        <h3>Middle School</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 6 to Class 8</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Hindi, Mathematics, Science, Social Science, Computer</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" data-group="stage-group" id="stage-secondary" hidden>
        <h3>Secondary (SSLC)</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 9 and Class 10</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Hindi, Mathematics, Science, Social Science, Computer, Physical Education</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="stage-section" id="fees">
  <div class="container py-5">
    <div class="mb-4">
      <h2 class="fw-bold text-white">Fees, transport and activities</h2>
      <p class="stage-sub">Annual fee structure, bus routes with stops and monthly charges, and optional activity programs.</p>
    </div>

    <div class="stage-tabs" role="tablist">
      <button class="stage-btn" data-tabbtn="fees-group" onclick="showTab('fees-group','fee-tuition', this)">Fee Structure</button>
      <button class="stage-btn" data-tabbtn="fees-group" onclick="showTab('fees-group','fee-transport', this)">Transport Routes</button>
      <button class="stage-btn" data-tabbtn="fees-group" onclick="showTab('fees-group','fee-sports', this)">Sports and Activities</button>
    </div>

    <div class="stage-panel" id="fees-panel" hidden>
      <div class="stage-detail tab-panel" data-group="fees-group" id="fee-tuition" hidden>
        <h3>Annual Tuition Fee Structure</h3>
        <div class="fee-grid">
          <div class="fee-item"><span class="fee-name">Nursery</span><span class="fee-amount">₹15,000</span></div>
          <div class="fee-item"><span class="fee-name">LKG</span><span class="fee-amount">₹16,000</span></div>
          <div class="fee-item"><span class="fee-name">UKG</span><span class="fee-amount">₹17,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 1</span><span class="fee-amount">₹25,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 2</span><span class="fee-amount">₹25,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 3</span><span class="fee-amount">₹26,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 4</span><span class="fee-amount">₹27,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 5</span><span class="fee-amount">₹28,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 6</span><span class="fee-amount">₹30,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 7</span><span class="fee-amount">₹31,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 8</span><span class="fee-amount">₹32,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 9</span><span class="fee-amount">₹35,000</span></div>
          <div class="fee-item"><span class="fee-name">Class 10 (SSLC)</span><span class="fee-amount">₹40,000</span></div>
        </div>
        <p class="stage-note">Tuition fees are assessed for the full academic year (2025-26) and can be paid in installments. Transport and activity fees are charged separately.</p>
      </div>

      <div class="stage-detail tab-panel" data-group="fees-group" id="fee-transport" hidden>
        <h3>Bus Routes and Transport Charges</h3>
        <div class="route-block">
          <h4>Route A: MG Road</h4>
          <div class="route-stops">Stops: MG Road, Brigade Cross, City Center</div>
          <div class="route-fee">₹700 per month <span class="route-annual">(₹7,000 for the year, 10 months)</span></div>
        </div>
        <div class="route-block">
          <h4>Route B: Jayanagar</h4>
          <div class="route-stops">Stops: Jayanagar 4th Block, South End, Ashoka Pillar</div>
          <div class="route-fee">₹650 per month <span class="route-annual">(₹6,500 for the year, 10 months)</span></div>
        </div>
        <div class="route-block">
          <h4>Route C: Whitefield</h4>
          <div class="route-stops">Stops: ITPL Main, Hope Farm, Hoodi Circle</div>
          <div class="route-fee">₹900 per month <span class="route-annual">(₹9,000 for the year, 10 months)</span></div>
        </div>
        <div class="route-block">
          <h4>Route D: Rajajinagar</h4>
          <div class="route-stops">Stops: Rajajinagar 2nd Stage, Chord Road, Basaveshwara Circle</div>
          <div class="route-fee">₹750 per month <span class="route-annual">(₹7,500 for the year, 10 months)</span></div>
        </div>
        <p class="stage-note">Transport enrollment and pickup points are assigned by the school office. Monthly fees cover ten months of service (June to March).</p>
      </div>

      <div class="stage-detail tab-panel" data-group="fees-group" id="fee-sports" hidden>
        <h3>Sports and Activity Programs</h3>
        <div class="fee-grid">
          <div class="fee-item"><span class="fee-name">Sports (Cricket)</span><span class="fee-amount">₹3,000</span></div>
          <div class="fee-item"><span class="fee-name">Sports (Football)</span><span class="fee-amount">₹2,800</span></div>
          <div class="fee-item"><span class="fee-name">Dance (Classical)</span><span class="fee-amount">₹2,500</span></div>
          <div class="fee-item"><span class="fee-name">Dance (Western)</span><span class="fee-amount">₹2,200</span></div>
          <div class="fee-item"><span class="fee-name">Music (Vocal)</span><span class="fee-amount">₹2,000</span></div>
          <div class="fee-item"><span class="fee-name">Music (Instrumental)</span><span class="fee-amount">₹3,500</span></div>
          <div class="fee-item"><span class="fee-name">Art and Craft</span><span class="fee-amount">₹1,500</span></div>
        </div>
        <p class="stage-note">Activity fees are annual and optional. Students can enroll in more than one program. Fees are recorded separately from tuition in each student's portal.</p>
      </div>
    </div>
  </div>
</section>

<section class="stage-section" id="about">
