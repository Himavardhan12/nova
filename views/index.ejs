<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <h1 class="mb-3">Student records, fees and exam results for Nursery through Class 10</h1>
        <p class="lead mb-4">
          This portal is used by Sunrise Public School staff, students and parents to manage
          and view admission details, fee payments, marks, bus routes and complaints.
        </p>
        <a href="/login" class="btn btn-warning btn-lg px-4 fw-semibold">Sign in to the portal</a>
      </div>
    </div>
  </div>
</section>

<section class="stage-section" id="classes">
  <div class="container py-5">
    <div class="mb-4">
      <h2 class="fw-bold text-white">Classes covered</h2>
      <p class="stage-sub">One student record system from entry level through the secondary board year.</p>
    </div>

    <div class="stage-tabs" role="tablist">
      <button class="stage-btn active" data-stage="early" onclick="showStage('early', this)">Early Years</button>
      <button class="stage-btn" data-stage="primary" onclick="showStage('primary', this)">Primary</button>
      <button class="stage-btn" data-stage="middle" onclick="showStage('middle', this)">Middle School</button>
      <button class="stage-btn" data-stage="secondary" onclick="showStage('secondary', this)">Secondary (SSLC)</button>
    </div>

    <div class="stage-panel">
      <div class="stage-detail" id="stage-early">
        <h3>Early Years</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Nursery, LKG, UKG</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Mathematics, EVS, Drawing</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" id="stage-primary" hidden>
        <h3>Primary</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 1 to Class 5</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Mathematics, EVS, Drawing</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" id="stage-middle" hidden>
        <h3>Middle School</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 6 to Class 8</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Hindi, Mathematics, Science, Social Science, Computer</span>
          </div>
        </div>
      </div>

      <div class="stage-detail" id="stage-secondary" hidden>
        <h3>Secondary (SSLC)</h3>
        <div class="stage-meta">
          <div class="stage-meta-item">
            <span class="stage-label">Classes</span>
            <span class="stage-value">Class 9 and Class 10</span>
          </div>
          <div class="stage-meta-item">
            <span class="stage-label">Subjects offered</span>
            <span class="stage-value">English, Kannada, Hindi, Mathematics, Science, Social Science, Computer, Physical Education</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container mb-5">
  <h2 class="fw-bold mb-4">What the portal provides</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Student profiles</h5>
          <p class="text-muted small mb-0">
            Every admitted student is issued a unique ID (format STU-YYYY-NNN). The profile
            holds personal details, address, parent name and phone, guardian name and phone,
            blood group and admission date.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Fee tracking</h5>
          <p class="text-muted small mb-0">
            Tuition, transport and activity fees are tracked separately. Each student record
            shows the total assessed, amount paid, receipts issued and the balance remaining.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="fw-bold">Academics, transport and complaints</h5>
          <p class="text-muted small mb-0">
            Exam marks and grades are recorded per subject. Bus route and pickup point details
            are shown for enrolled students. Complaints can be submitted and tracked to resolution.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function showStage(stage, btn) {
  document.querySelectorAll('.stage-detail').forEach(function (el) { el.hidden = true; });
  document.querySelectorAll('.stage-btn').forEach(function (el) { el.classList.remove('active'); });
  document.getElementById('stage-' + stage).hidden = false;
  btn.classList.add('active');
}
</script>

<%- include('partials/footer') %>
