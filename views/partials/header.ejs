<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Sunrise Public School</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>">
  <meta name="description" content="Sunrise Public School portal for student records, fees, exam results, transport and complaints. Nursery through Class 10 (SSLC).">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="<%= currentPath === '/' ? 'home-body' : '' %>">
<nav class="navbar navbar-expand-lg navbar-dark no-print">
  <div class="container">
    <a class="navbar-brand" href="/">Sunrise Public School</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <% if (!user) { %>
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <% } else { %>
          <li class="nav-item"><span class="nav-link text-warning fw-semibold"><%= user.username %></span></li>
          <li class="nav-item">
            <form method="POST" action="/logout" class="d-inline">
              <button class="btn btn-outline-light btn-sm ms-lg-2 mt-2 mt-lg-0" type="submit">Logout</button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<main>
