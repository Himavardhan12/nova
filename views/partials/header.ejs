<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Sunrise Public School</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>">
  <meta name="description" content="Sunrise Public School portal for student records, fees, exam results, transport and complaints. Nursery through Class 10 (SSLC).">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="<%= currentPath === '/' ? 'home-body' : '' %>">
<div class="scroll-progress" id="scrollProgress"></div>
<% if (currentPath === '/') { %>
<div class="ticker no-print" aria-hidden="true">
  <div class="ticker-track">
    <div class="ticker-half">
      <span>Admissions open for 2026-27</span><span class="tick-sep">&#9670;</span>
      <span>Nursery to Class 10 (SSLC)</span><span class="tick-sep">&#9670;</span>
      <span>Call +91 78925 52978</span><span class="tick-sep">&#9670;</span>
      <span>saihimavardhan001@gmail.com</span><span class="tick-sep">&#9670;</span>
      <span>4 bus routes across Bengaluru</span><span class="tick-sep">&#9670;</span>
    </div>
    <div class="ticker-half">
      <span>Admissions open for 2026-27</span><span class="tick-sep">&#9670;</span>
      <span>Nursery to Class 10 (SSLC)</span><span class="tick-sep">&#9670;</span>
      <span>Call +91 78925 52978</span><span class="tick-sep">&#9670;</span>
      <span>saihimavardhan001@gmail.com</span><span class="tick-sep">&#9670;</span>
      <span>4 bus routes across Bengaluru</span><span class="tick-sep">&#9670;</span>
    </div>
  </div>
</div>
<% } %>
<nav class="navbar navbar-expand-lg navbar-dark no-print">
  <div class="container">
    <a class="navbar-brand" href="/">Sunrise Public School</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <% if (!user) { %>
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <% } else { %>
          <li class="nav-item"><span class="nav-link text-warning fw-semibold"><%= user.username %></span></li>
          <li class="nav-item">
            <form method="POST" action="/logout" class="d-inline">
              <button class="btn btn-outline-light btn-sm ms-lg-2 mt-2 mt-lg-0" type="submit">Logout</button>
            </form>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
<main>
