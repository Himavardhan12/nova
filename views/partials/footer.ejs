<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  var bar = document.getElementById('scrollProgress');
  var nav = document.querySelector('.navbar');
  function onScroll() {
    var d = document.documentElement;
    var max = d.scrollHeight - d.clientHeight;
    if (bar) bar.style.width = (max > 0 ? (d.scrollTop / max) * 100 : 0) + '%';
    if (nav) nav.classList.toggle('scrolled', d.scrollTop > 8);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();

(function () {
  var canvas = document.getElementById('bgCanvas');
  if (!canvas) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    canvas.style.display = 'none';
    return;
  }
  var ctx = canvas.getContext('2d');
  if (!ctx) return;
  var W = 0, H = 0, blobs = [], streaks = [], dust = [];
  var raf = null, running = false, t = 0;

  var palette = [
    [18, 20, 26], [28, 32, 40], [12, 14, 18],
    [40, 46, 56], [22, 26, 34], [50, 56, 68],
    [16, 18, 24], [34, 38, 48], [26, 30, 38]
  ];

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    var mobile = W < 768;
    var n = mobile ? 6 : 10;
    blobs = [];
    for (var i = 0; i < n; i++) {
      var p = palette[i % palette.length];
      blobs.push({
        x: Math.random() * W, y: Math.random() * H,
        r: 180 + Math.random() * 340,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        p: p, a: 0.1 + Math.random() * 0.08,
        ph: Math.random() * Math.PI * 2
      });
    }
    streaks = [];
    var dn = mobile ? 30 : 60;
    dust = [];
    for (var k = 0; k < dn; k++) {
      dust.push({
        x: Math.random() * W, y: Math.random() * H,
        r: Math.random() * 1.4 + 0.4,
        vx: (Math.random() - 0.5) * 0.15,
        vy: -0.05 - Math.random() * 0.2,
        a: 0.15 + Math.random() * 0.35,
        tw: Math.random() * Math.PI * 2
      });
    }
  }

  function spawnStreak() {
    if (streaks.length > 3) return;
    var fromLeft = Math.random() > 0.5;
    streaks.push({
      x: fromLeft ? -60 : W + 60,
      y: Math.random() * H * 0.6,
      vx: fromLeft ? (2.5 + Math.random() * 3) : -(2.5 + Math.random() * 3),
      vy: 0.4 + Math.random() * 0.8,
      len: 90 + Math.random() * 120,
      life: 1,
      decay: 0.006 + Math.random() * 0.006
    });
  }

  function draw() {
    if (!running) return;
    t += 0.008;
    ctx.clearRect(0, 0, W, H);

    for (var i = 0; i < blobs.length; i++) {
      var b = blobs[i];
      b.x += b.vx + Math.sin(t * 0.7 + b.ph) * 0.15;
      b.y += b.vy + Math.cos(t * 0.5 + b.ph) * 0.12;
      if (b.x < -b.r) b.x = W + b.r;
      if (b.x > W + b.r) b.x = -b.r;
      if (b.y < -b.r) b.y = H + b.r;
      if (b.y > H + b.r) b.y = -b.r;
      var pulse = 1 + Math.sin(t * 1.2 + b.ph) * 0.08;
      var rr = b.r * pulse;
      var g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, rr);
      g.addColorStop(0, 'rgba(' + b.p[0] + ',' + b.p[1] + ',' + b.p[2] + ',' + b.a + ')');
      g.addColorStop(0.6, 'rgba(' + b.p[0] + ',' + b.p[1] + ',' + b.p[2] + ',' + (b.a * 0.35) + ')');
      g.addColorStop(1, 'rgba(' + b.p[0] + ',' + b.p[1] + ',' + b.p[2] + ',0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(b.x, b.y, rr, 0, Math.PI * 2);
      ctx.fill();
    }

    for (var d = 0; d < dust.length; d++) {
      var p = dust[d];
      p.x += p.vx + Math.sin(t + p.tw) * 0.05;
      p.y += p.vy;
      p.tw += 0.02;
      if (p.y < -4) { p.y = H + 4; p.x = Math.random() * W; }
      if (p.x < -4) p.x = W + 4;
      if (p.x > W + 4) p.x = -4;
      var tw = 0.5 + Math.sin(p.tw) * 0.5;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(232, 234, 237,' + (p.a * tw) + ')';
      ctx.fill();
    }

    if (Math.random() < 0.012) spawnStreak();
    for (var s = streaks.length - 1; s >= 0; s--) {
      var st = streaks[s];
      st.x += st.vx;
      st.y += st.vy;
      st.life -= st.decay;
      if (st.life <= 0 || st.x < -200 || st.x > W + 200) { streaks.splice(s, 1); continue; }
      var grad = ctx.createLinearGradient(st.x, st.y, st.x - st.vx * (st.len / 3), st.y - st.vy * (st.len / 3));
      grad.addColorStop(0, 'rgba(180, 186, 196,' + (0.45 * st.life) + ')');
      grad.addColorStop(1, 'rgba(180, 186, 196,0)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.moveTo(st.x, st.y);
      ctx.lineTo(st.x - st.vx * (st.len / 3), st.y - st.vy * (st.len / 3));
      ctx.stroke();
    }

    raf = requestAnimationFrame(draw);
  }

  function start() { if (!running) { running = true; draw(); } }
  function stop() { running = false; if (raf) cancelAnimationFrame(raf); raf = null; }

  resize();
  window.addEventListener('resize', resize);
  document.addEventListener('visibilitychange', function () {
    document.hidden ? stop() : start();
  });
  start();
})();
</script>
</body>
</html>
