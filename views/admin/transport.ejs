<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/admin-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <h3 class="fw-bold mb-0">Transport Management</h3>
        <p class="text-muted mb-0">Bus routes and student enrollments</p>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">Add New Route</div>
            <div class="card-body">
              <form method="POST" action="/admin/transport/new">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Route Name</label>
                  <input type="text" name="route_name" class="form-control" placeholder="e.g. Route E - Hebbal" required>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Stops</label>
                  <input type="text" name="stops" class="form-control" placeholder="Comma-separated stops">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Monthly Fee (₹)</label>
                  <input type="number" name="monthly_fee" class="form-control" min="0" step="50" required>
                </div>
                <button class="btn btn-primary w-100">Add Route</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="card h-100">
            <div class="card-header">Active Routes</div>
            <div class="table-responsive">
              <table class="table mb-0">
                <thead class="table-light"><tr><th>Route</th><th>Stops</th><th class="text-end">Monthly Fee</th><th class="text-center">Students</th></tr></thead>
                <tbody>
                  <% routes.forEach(r => { %>
                    <tr>
                      <td class="fw-semibold"><%= r.route_name %></td>
                      <td class="small text-muted"><%= r.stops || 'N/A' %></td>
                      <td class="text-end">₹<%= r.monthly_fee %></td>
                      <td class="text-center"><span class="badge text-bg-primary"><%= r.student_count %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">Enrolled Students (<%= students.length %>)</div>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Student ID</th><th>Name</th><th>Class</th><th>Route</th><th>Pickup Point</th><th></th></tr></thead>
            <tbody>
              <% students.forEach(s => { %>
                <tr>
                  <td class="font-monospace small"><%= s.student_code %></td>
                  <td class="fw-semibold"><%= s.name %></td>
                  <td><%= s.class %></td>
                  <td><%= s.route_name %></td>
                  <td><%= s.pickup_point || 'N/A' %></td>
                  <td class="text-end"><a href="/admin/students/<%= s.id %>" class="btn btn-sm btn-outline-primary">Profile</a></td>
                </tr>
              <% }) %>
              <% if (!students.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No students enrolled in transport.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
