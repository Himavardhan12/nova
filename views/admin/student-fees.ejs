<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/admin-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <a href="/admin/students/<%= student.id %>" class="text-decoration-none small">Back to Profile</a>
        <h3 class="fw-bold mt-2 mb-0">Fee Management: <%= student.name %></h3>
        <span class="badge text-bg-dark font-monospace"><%= student.student_code %></span>
        <span class="badge text-bg-primary"><%= student.class %></span>
      </div>

      <% if (success) { %><div class="alert alert-success">Payment recorded successfully.</div><% } %>

      <div class="row g-4 mb-4">
        <div class="col-md-3">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Total Due</div>
            <div class="stat-value">₹<%= Number(fee.totalDue).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
        <div class="col-md-3">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Paid</div>
            <div class="stat-value text-success">₹<%= Number(fee.totalPaid).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
        <div class="col-md-3">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Remaining</div>
            <div class="stat-value <%= fee.remaining > 0 ? 'text-danger' : 'text-success' %>">₹<%= Number(fee.remaining).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
        <div class="col-md-3">
          <div class="card"><div class="card-body text-center">
            <div class="small text-muted">Progress</div>
            <div class="progress progress-thin mt-2">
              <% const pct = fee.totalDue ? Math.min(100, (fee.totalPaid / fee.totalDue) * 100) : 100; %>
              <div class="progress-bar <%= fee.remaining > 0 ? 'bg-warning' : 'bg-success' %>" style="width: <%= pct %>%"></div>
            </div>
            <div class="fw-semibold mt-2"><%= pct.toFixed(0) %>% collected</div>
          </div></div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">Record Payment</div>
            <div class="card-body">
              <form method="POST" action="/admin/students/<%= student.id %>/fees/pay">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Category</label>
                  <select name="category" class="form-select" required onchange="toggleActivity(this.value)">
                    <option value="tuition">Tuition Fee</option>
                    <option value="transport" <%= !student.transport_route_id ? 'disabled' : '' %>>Transport Fee</option>
                    <option value="activity">Activity Fee</option>
                  </select>
                </div>
                <div class="mb-3" id="activityRow" style="display:none;">
                  <label class="form-label fw-semibold">Activity</label>
                  <select name="activity_id" class="form-select">
                    <option value="">Select activity</option>
                    <% (fee.activities || []).forEach(a => { %>
                      <option value="<%= a.id %>"><%= a.name %> (₹<%= a.fee %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Amount (₹)</label>
                  <input type="number" name="amount" class="form-control" min="1" step="0.01" required>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Payment Date</label>
                  <input type="date" name="payment_date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Mode</label>
                  <select name="mode" class="form-select">
                    <option value="cash">Cash</option>
                    <option value="upi">UPI</option>
                    <option value="card">Card</option>
                    <option value="cheque">Cheque</option>
                    <option value="bank_transfer">Bank Transfer</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Receipt No.</label>
                  <input type="text" name="receipt_no" class="form-control" value="RCT-<%= nextReceipt %>">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Notes</label>
                  <input type="text" name="notes" class="form-control" placeholder="Optional note">
                </div>
                <button type="submit" class="btn btn-success w-100 fw-semibold">Record Payment</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">Payment History</div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table mb-0">
                  <thead class="table-light"><tr><th>Receipt</th><th>Date</th><th>Category</th><th>Mode</th><th>Note</th><th class="text-end">Amount</th></tr></thead>
                  <tbody>
                    <% payments.forEach(p => { %>
                      <tr>
                        <td class="font-monospace small"><%= p.receipt_no || 'N/A' %></td>
                        <td><%= p.payment_date %></td>
                        <td><%= p.category %><% if (p.activity_name) { %><div class="small text-muted"><%= p.activity_name %></div><% } %></td>
                        <td class="text-capitalize"><%= p.mode %></td>
                        <td class="small text-muted"><%= p.notes || 'N/A' %></td>
                        <td class="text-end fw-semibold">₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
                      </tr>
                    <% }) %>
                    <% if (!payments.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No payments yet</td></tr><% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function toggleActivity(val) {
  document.getElementById('activityRow').style.display = val === 'activity' ? 'block' : 'none';
}
</script>

<%- include('../partials/footer') %>
