<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/admin-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="mb-4">
        <h3 class="fw-bold mb-0">Extra Activities</h3>
        <p class="text-muted mb-0">Sports, Dance, Music, Art programs</p>
      </div>

      <div class="row g-4">
        <% activities.forEach(a => { %>
          <div class="col-md-6 col-xl-4">
            <div class="card h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h5 class="fw-bold mb-1"><%= a.name %></h5>
                    <p class="small text-muted mb-2"><%= a.description || '' %></p>
                  </div>
                  <i class="bi bi-trophy text-warning" style="font-size: 1.8rem;"></i>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <div>
                    <div class="small text-muted">Annual Fee</div>
                    <div class="fw-bold text-primary">₹<%= a.fee %></div>
                  </div>
                  <div class="text-end">
                    <div class="small text-muted">Enrolled</div>
                    <span class="badge text-bg-success fs-6"><%= a.enrolled_count %> students</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
