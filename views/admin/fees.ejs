<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-lg-2 col-md-3">
      <%- include('../partials/admin-nav') %>
    </div>
    <div class="col-lg-10 col-md-9">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h3 class="fw-bold mb-0">Fee Report</h3>
          <p class="text-muted mb-0">Academic Year 2025-26 — all classes</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-secondary no-print"><i class="bi bi-printer me-1"></i>Print</button>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Total Receivable</div>
            <div class="stat-value">₹<%= Number(totals.due).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
        <div class="col-md-4">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Total Collected</div>
            <div class="stat-value text-success">₹<%= Number(totals.paid).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
        <div class="col-md-4">
          <div class="card stat-card text-center"><div class="card-body">
            <div class="stat-label">Total Outstanding</div>
            <div class="stat-value text-danger">₹<%= Number(totals.remaining).toLocaleString('en-IN') %></div>
          </div></div>
        </div>
      </div>

      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Class</th>
                <th class="text-end">Total Due</th>
                <th class="text-end">Paid</th>
                <th class="text-end">Remaining</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(r => { %>
                <tr>
                  <td class="font-monospace small"><%= r.student.student_code %></td>
                  <td class="fw-semibold"><%= r.student.name %></td>
                  <td><%= r.student.class %></td>
                  <td class="text-end">₹<%= Number(r.fee.totalDue).toLocaleString('en-IN') %></td>
                  <td class="text-end text-success">₹<%= Number(r.fee.totalPaid).toLocaleString('en-IN') %></td>
                  <td class="text-end fw-semibold <%= r.fee.remaining > 0 ? 'text-danger' : 'text-success' %>">₹<%= Number(r.fee.remaining).toLocaleString('en-IN') %></td>
                  <td>
                    <% if (r.fee.remaining <= 0) { %><span class="badge badge-paid">Paid</span>
                    <% } else if (r.fee.totalPaid > 0) { %><span class="badge badge-partial">Partial</span>
                    <% } else { %><span class="badge badge-due">Pending</span><% } %>
                  </td>
                  <td class="text-end"><a href="/admin/students/<%= r.student.id %>/fees" class="btn btn-sm btn-outline-success no-print">Manage</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
